{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "trailingSlash": false,
  "redirects": [
    { "source": "/weet", "destination": "/denk", "permanent": true },
    { "source": "/weet/", "destination": "/denk", "permanent": true },
    { "source": "/weet/:path*", "destination": "/denk/:path*", "permanent": true },
    { "source": "/kennis", "destination": "/denk", "permanent": true },
    { "source": "/kennis/", "destination": "/denk", "permanent": true },
    { "source": "/kennis/:path*", "destination": "/denk/:path*", "permanent": true }
  ],
  "rewrites": [{ "source": "/favicon.ico", "destination": "/favicon.svg" }]
}
